{
  "name": "muftah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest-unit.json",
    "test:int": "vitest run --project integration --reporter=default --reporter=json --outputFile.json=reports/vitest-integration.json",
    "e2e": "playwright test",
    "e2e:linux": "node scripts/e2e-linux.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:dashes": "node scripts/check-dashes.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:seed": "node scripts/validate-seed.ts",
    "metrics": "node scripts/metrics.ts",
    "lhci": "node scripts/lhci.ts",
    "audit:deps": "node scripts/audit-deps.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm test:int && pnpm check:i18n && pnpm check:dashes && pnpm check:contrast && pnpm build && pnpm check:bundle",
    "verify:full": "pnpm verify && pnpm e2e && pnpm e2e:linux && pnpm lhci && pnpm audit:deps",
    "i18n:deck-keys": "node scripts/deck-keys.ts",
    "i18n:messages": "node scripts/deck-to-messages.ts && node scripts/deck-keys.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "fixtures:spin": "node scripts/fixtures/spin-dials.ts",
    "fixtures:sound": "node scripts/fixtures/engine-clips.ts",
    "fonts:fallbacks": "node scripts/font-fallbacks.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@gsap/react": "2.1.2",
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/blob": "2.8.2",
    "barcode-detector": "3.2.2",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cobe": "2.0.1",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "mediabunny": "1.61.5",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@next/env": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "intl-messageformat": "11.2.15",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
