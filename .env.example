# Every environment variable Muftah reads (SRS §15.1), with the values for local work.
# Copy this file to .env.local, then fill in the three empty secrets. A filled-in copy is never
# committed: secrets live only in .env.local and in the deployment's environment settings.
# Optional variables stay commented out, because an empty value is not the same as an unset one.
# Make each generated secret with: openssl rand -base64 32

# Database. Locally: Postgres 17 behind Neon's local proxy (pnpm db:up, then pnpm db:migrate),
# with compose.yaml's throwaway credentials. On a deployment: Neon's pooled and direct URLs (secret).
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@db.localtest.me:5432/main

# Auth. The secret is generated: at least 32 random bytes.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The root key of the rate-limit keys (SEC-12), generated like the auth secret
RATE_LIMIT_HMAC_SECRET=

# The canonical origin, for metadata, links and QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage. STORAGE_DRIVER=local keeps files in .storage-local/ and refuses to run on a deployment.
# Its token is local too: vercel_blob_rw_local_ and a random value, made with
#   echo "vercel_blob_rw_local_$(openssl rand -hex 16)"
# On a deployment, STORAGE_DRIVER and the API URL are unset, and the token comes from Vercel (secret).
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:3000/api/storage-local?
# Moves the local store (tests use a temporary folder)
# STORAGE_LOCAL_ROOT=.storage-local
# The Blob store's host, for the content security policy (recorded when the store exists)
# BLOB_STORE_HOST=abc123.public.blob.vercel-storage.com
# Monthly storage-write budget on the Hobby demo; unset means no budget
# BLOB_MONTHLY_OP_BUDGET=1500
# The demo's private store for visitors' uploads, only where DEMO_MODE=true (secret, from Vercel)
# DEMO_BLOB_READ_WRITE_TOKEN=
# A development tunnel for upload callbacks
# VERCEL_BLOB_CALLBACK_URL=https://xyz.ngrok.app

# Generated secrets for the cron routes, the deep health check and recovery codes
# CRON_SECRET=
# HEALTH_TOKEN=
# RECOVERY_CODE_HMAC_SECRET=

# The deployment
DEALER_SLUG=muftah
DEMO_MODE=true
FF_REEL_IT=false
FF_SHOWROOM_FLOOR=true
HIBP_CHECK_ENABLED=true
LOG_LEVEL=info
# The public repository link, unset until the owner approves it
# REPO_URL=https://github.com/owner/repository

# Scripts only, never set on a deployment
# OWNER_EMAIL=owner@example.com
# PEXELS_API_KEY=

# VERCEL_ENV is set by Vercel and never by hand: the local store and the development pages refuse
# to run when it is preview or production.
